{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekh.local/schemas/lekh-neural-manifest.schema.json",
  "title": "Lekh production neural transliterator manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trainingRunId",
    "exportRunId",
    "selectedArtifact",
    "runtime",
    "localOnly",
    "neuralTailOnly",
    "productionEligible",
    "architecture",
    "openVocabulary",
    "tokenization",
    "outputSequenceValidation",
    "decoder",
    "beamSearch",
    "languageModelRescorer",
    "contextWindowWords",
    "parameterCount",
    "modelBytes",
    "trainingSources",
    "datasetReports",
    "evaluationReports",
    "benchmarkReports",
    "metrics",
    "performance",
    "requiredCases",
    "sha256",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "trainingRunId": {
      "$ref": "#/$defs/runIdentifier"
    },
    "exportRunId": {
      "$ref": "#/$defs/runIdentifier"
    },
    "selectedArtifact": {
      "enum": [
        "lekh-open-vocab-seq2seq-v1",
        "lekh-open-vocab-bigru-attention-v1",
        "lekh-open-vocab-ctc-transformer-v2"
      ]
    },
    "runtime": {
      "const": "CoreML"
    },
    "runtimeModelContract": {
      "enum": [
        "split-attention-incremental-v1",
        "single-transformer-ctc-v1"
      ]
    },
    "tensorContract": {
      "oneOf": [
        {
          "$ref": "#/$defs/tensorContract"
        },
        {
          "$ref": "#/$defs/ctcTensorContract"
        }
      ]
    },
    "compiledModels": {
      "$ref": "#/$defs/compiledModels"
    },
    "localOnly": {
      "const": true
    },
    "neuralTailOnly": {
      "const": true
    },
    "productionEligible": {
      "const": true
    },
    "architecture": {
      "type": "string",
      "pattern": "([Gg][Rr][Uu]|[Tt]ransformer|seq2seq|encoder-decoder)"
    },
    "openVocabulary": {
      "const": true
    },
    "tokenization": {
      "const": "unicode-scalar-character"
    },
    "outputSequenceValidation": {
      "const": "devanagari-word-sequence-v1"
    },
    "decoder": {
      "enum": [
        "beam-search",
        "ctc-prefix-beam-search"
      ]
    },
    "beamSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "beamWidth", "maxOutputGraphemes", "maxSteps"],
      "properties": {
        "enabled": {
          "const": true
        },
        "beamWidth": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "maxOutputGraphemes": {
          "const": 32
        },
        "maxSteps": {
          "enum": [31, 32]
        }
      }
    },
    "languageModelRescorer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "source", "weight"],
      "properties": {
        "enabled": {
          "const": false
        },
        "source": {
          "const": "none"
        },
        "weight": {
          "const": 0
        }
      }
    },
    "contextWindowWords": {
      "const": 0
    },
    "parameterCount": {
      "type": "integer",
      "minimum": 1000000,
      "maximum": 5000000
    },
    "modelBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "trainingSources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "allOf": [
        {
          "contains": {
            "const": "ai4bharat-aksharantar-nepali"
          }
        }
      ]
    },
    "datasetReports": {
      "$ref": "#/$defs/reportList"
    },
    "evaluationReports": {
      "$ref": "#/$defs/reportList"
    },
    "benchmarkReports": {
      "$ref": "#/$defs/reportList"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tailTop1Accuracy",
        "tailTop3Accuracy",
        "chatConventionTop1Accuracy",
        "chatConventionTop3Accuracy",
        "namesTop3Accuracy",
        "protectedFalseConversionRate",
        "singleTokenPhraseExpansionRate",
        "secureFieldInferenceCount"
      ],
      "properties": {
        "tailTop1Accuracy": {
          "type": "number",
          "minimum": 0.88,
          "maximum": 1
        },
        "tailTop3Accuracy": {
          "type": "number",
          "minimum": 0.96,
          "maximum": 1
        },
        "chatConventionTop1Accuracy": {
          "type": "number",
          "minimum": 0.92,
          "maximum": 1
        },
        "chatConventionTop3Accuracy": {
          "type": "number",
          "minimum": 0.98,
          "maximum": 1
        },
        "namesTop3Accuracy": {
          "type": "number",
          "minimum": 0.9,
          "maximum": 1
        },
        "protectedFalseConversionRate": {
          "const": 0
        },
        "singleTokenPhraseExpansionRate": {
          "const": 0
        },
        "secureFieldInferenceCount": {
          "const": 0
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50Ms", "p95Ms", "p99Ms", "targetP99Ms", "measuredOnDevice", "memory", "devices"],
      "properties": {
        "p50Ms": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 50
        },
        "p95Ms": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 50
        },
        "p99Ms": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 50
        },
        "targetP99Ms": {
          "const": 50
        },
        "measuredOnDevice": {
          "const": true
        },
        "memory": {
          "$ref": "#/$defs/postExportMemoryEvidence"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "macOS",
              "architecture",
              "packagedApp",
              "secureFieldInferenceCount",
              "p50Ms",
              "p95Ms",
              "p99Ms",
              "artifact",
              "measurementKind",
              "memory"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "macOS": {
                "type": "string",
                "minLength": 1
              },
              "architecture": {
                "enum": ["arm64", "x86_64"]
              },
              "packagedApp": {
                "const": true
              },
              "secureFieldInferenceCount": {
                "const": 0
              },
              "p50Ms": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 50
              },
              "p95Ms": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 50
              },
              "p99Ms": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 50
              },
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "measurementKind": {
                "const": "full-candidate-generation"
              },
              "memory": {
                "$ref": "#/$defs/postExportMemoryEvidence"
              }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["architecture"],
                "properties": {
                  "architecture": {
                    "const": "arm64"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "requiredCases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vato", "bato", "baato", "chha", "cha", "xa", "xaina"],
      "properties": {
        "vato": {
          "const": "बाटो"
        },
        "bato": {
          "const": "बाटो"
        },
        "baato": {
          "const": "बाटो"
        },
        "chha": {
          "const": "छ"
        },
        "cha": {
          "const": "छ"
        },
        "xa": {
          "const": "छ"
        },
        "xaina": {
          "const": "छैन"
        }
      }
    },
    "sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/baselineHashes"
        },
        {
          "$ref": "#/$defs/splitHashes"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "oneOf": [
    {
      "title": "Single-model GRU encoder-decoder",
      "properties": {
        "selectedArtifact": {
          "const": "lekh-open-vocab-seq2seq-v1"
        },
        "architecture": {
          "const": "gru-encoder-decoder-seq2seq"
        },
        "decoder": {
          "const": "beam-search"
        },
        "beamSearch": {
          "type": "object",
          "properties": {
            "maxSteps": {
              "const": 31
            }
          }
        },
        "runtimeModelContract": false,
        "tensorContract": false,
        "compiledModels": false,
        "sha256": {
          "$ref": "#/$defs/baselineHashes"
        }
      }
    },
    {
      "title": "Split incremental attention encoder/decoder-step",
      "required": [
        "runtimeModelContract",
        "tensorContract",
        "compiledModels"
      ],
      "properties": {
        "selectedArtifact": {
          "const": "lekh-open-vocab-bigru-attention-v1"
        },
        "architecture": {
          "const": "bidirectional-gru-additive-attention-seq2seq"
        },
        "runtimeModelContract": {
          "const": "split-attention-incremental-v1"
        },
        "tensorContract": {
          "$ref": "#/$defs/tensorContract"
        },
        "decoder": {
          "const": "beam-search"
        },
        "beamSearch": {
          "type": "object",
          "properties": {
            "maxSteps": {
              "const": 31
            }
          }
        },
        "sha256": {
          "$ref": "#/$defs/splitHashes"
        }
      }
    },
    {
      "title": "Single-model fixed-shape Transformer CTC",
      "required": [
        "runtimeModelContract",
        "tensorContract"
      ],
      "properties": {
        "selectedArtifact": {
          "const": "lekh-open-vocab-ctc-transformer-v2"
        },
        "architecture": {
          "const": "fixed-shape-transformer-ctc"
        },
        "runtimeModelContract": {
          "const": "single-transformer-ctc-v1"
        },
        "tensorContract": {
          "$ref": "#/$defs/ctcTensorContract"
        },
        "compiledModels": false,
        "decoder": {
          "const": "ctc-prefix-beam-search"
        },
        "beamSearch": {
          "type": "object",
          "properties": {
            "beamWidth": {
              "const": 8
            },
            "maxSteps": {
              "const": 32
            }
          }
        },
        "sha256": {
          "$ref": "#/$defs/baselineHashes"
        }
      }
    }
  ],
  "$defs": {
    "postExportMemoryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "measurementKind",
        "api",
        "units",
        "baselinePhysicalFootprintBytes",
        "lifetimePeakPhysicalFootprintBytes",
        "peakIncreaseFromBaselineBytes"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "measurementKind": {
          "const": "isolated-process-physical-footprint-v1"
        },
        "api": {
          "const": "proc_pid_rusage:RUSAGE_INFO_V4"
        },
        "units": {
          "const": "bytes"
        },
        "baselinePhysicalFootprintBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "lifetimePeakPhysicalFootprintBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "peakIncreaseFromBaselineBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217727
        }
      }
    },
    "reportList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^reports/.+\\.json$"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runIdentifier": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "baselineHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiledModel",
        "sourceCheckpoint",
        "trainingDatasetManifest",
        "vocabMetadata"
      ],
      "properties": {
        "compiledModel": {
          "$ref": "#/$defs/sha256"
        },
        "sourceCheckpoint": {
          "$ref": "#/$defs/sha256"
        },
        "trainingDatasetManifest": {
          "$ref": "#/$defs/sha256"
        },
        "vocabMetadata": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "splitHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiledModels",
        "mlpackages",
        "sourceCheckpoint",
        "trainingDatasetManifest",
        "vocabMetadata"
      ],
      "properties": {
        "compiledModels": {
          "$ref": "#/$defs/roleHashes"
        },
        "mlpackages": {
          "$ref": "#/$defs/roleHashes"
        },
        "sourceCheckpoint": {
          "$ref": "#/$defs/sha256"
        },
        "trainingDatasetManifest": {
          "$ref": "#/$defs/sha256"
        },
        "vocabMetadata": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "roleHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoder", "decoderStep"],
      "properties": {
        "encoder": {
          "$ref": "#/$defs/sha256"
        },
        "decoderStep": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "compiledModels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoder", "decoderStep"],
      "properties": {
        "encoder": {
          "$ref": "#/$defs/encoderArtifact"
        },
        "decoderStep": {
          "$ref": "#/$defs/decoderStepArtifact"
        }
      }
    },
    "encoderArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/compiledArtifact"
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "encoder"
            }
          }
        }
      ]
    },
    "decoderStepArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/compiledArtifact"
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "decoderStep"
            }
          }
        }
      ]
    },
    "compiledArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "mlpackage",
        "mlpackageBytes",
        "mlpackageSha256",
        "compiledModel",
        "compiledBytes",
        "compiledSha256"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "mlpackage": {
          "$ref": "#/$defs/repositoryPath"
        },
        "mlpackageBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "mlpackageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "compiledModel": {
          "$ref": "#/$defs/repositoryPath"
        },
        "compiledBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "compiledSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "dataType"],
      "properties": {
        "shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        },
        "dataType": {
          "enum": ["INT32", "FLOAT16"]
        }
      }
    },
    "tensorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoder", "decoderStep"],
      "properties": {
        "encoder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["inputIds"],
              "properties": {
                "inputIds": {
                  "$ref": "#/$defs/tensor"
                }
              }
            },
            "outputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoderOutputs",
                "encoderEnergy",
                "validMask",
                "initialDecoderHidden"
              ],
              "properties": {
                "encoderOutputs": {
                  "$ref": "#/$defs/tensor"
                },
                "encoderEnergy": {
                  "$ref": "#/$defs/tensor"
                },
                "validMask": {
                  "$ref": "#/$defs/tensor"
                },
                "initialDecoderHidden": {
                  "$ref": "#/$defs/tensor"
                }
              }
            }
          }
        },
        "decoderStep": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decoderTokenIds",
                "decoderHidden",
                "encoderOutputs",
                "encoderEnergy",
                "validMask"
              ],
              "properties": {
                "decoderTokenIds": {
                  "$ref": "#/$defs/tensor"
                },
                "decoderHidden": {
                  "$ref": "#/$defs/tensor"
                },
                "encoderOutputs": {
                  "$ref": "#/$defs/tensor"
                },
                "encoderEnergy": {
                  "$ref": "#/$defs/tensor"
                },
                "validMask": {
                  "$ref": "#/$defs/tensor"
                }
              }
            },
            "outputs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stepLogits", "nextDecoderHidden"],
              "properties": {
                "stepLogits": {
                  "$ref": "#/$defs/tensor"
                },
                "nextDecoderHidden": {
                  "$ref": "#/$defs/tensor"
                }
              }
            }
          }
        }
      }
    },
    "ctcTensorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputIds", "logits"],
      "properties": {
        "inputIds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "dataType"],
          "properties": {
            "shape": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "const": 1
                },
                {
                  "const": 32
                }
              ],
              "items": false
            },
            "dataType": {
              "const": "INT32"
            }
          }
        },
        "logits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "dataType"],
          "properties": {
            "shape": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "const": 1
                },
                {
                  "const": 32
                },
                {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 1048576
                }
              ],
              "items": false
            },
            "dataType": {
              "const": "FLOAT16"
            }
          }
        }
      }
    }
  }
}
