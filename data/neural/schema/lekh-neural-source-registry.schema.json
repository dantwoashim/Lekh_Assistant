{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekh.local/schemas/lekh-neural-source-registry.schema.json",
  "title": "Lekh neural source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "phase", "output", "productionRequiredSources", "sources"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "phase": {
      "const": "phase2-source-cleaning"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetDir", "manifestPath", "reportPath"],
      "properties": {
        "datasetDir": {
          "const": "data/generated/neural-open-vocab"
        },
        "manifestPath": {
          "const": "data/generated/neural-open-vocab/manifest.json"
        },
        "reportPath": {
          "const": "reports/neural-open-vocab-dataset-report.json"
        }
      }
    },
    "productionRequiredSources": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "ai4bharat-aksharantar-nepali"
          }
        },
        {
          "contains": {
            "const": "human-reviewed-lekh-gold-v1"
          }
        },
        {
          "contains": {
            "const": "lekh-chat-conventions-v1"
          }
        },
        {
          "contains": {
            "const": "lekh-name-lexicon-v1"
          }
        }
      ],
      "not": {
        "contains": {
          "enum": [
            "syubraj-roman2nepali-transliteration",
            "saugatkafley-nepali-roman-transliteration"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tier",
          "license",
          "status",
          "rawDataCommitted",
          "allowedForOpenVocabTokenTraining",
          "productionRequired",
          "defaultPath",
          "notes"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "syubraj-roman2nepali-transliteration",
                    "saugatkafley-nepali-roman-transliteration"
                  ]
                }
              },
              "required": ["id"]
            },
            "then": {
              "required": ["lineageId", "canonicalTrainingSource"],
              "properties": {
                "tier": {
                  "const": "local-research-only"
                },
                "status": {
                  "const": "blocked"
                },
                "allowedForOpenVocabTokenTraining": {
                  "const": false
                },
                "productionRequired": {
                  "const": false
                },
                "lineageId": {
                  "const": "aksharantar-nepali-public-lineage"
                },
                "canonicalTrainingSource": {
                  "const": "ai4bharat-aksharantar-nepali"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "ai4bharat-aksharantar-nepali"
                }
              },
              "required": ["id"]
            },
            "then": {
              "required": ["lineageId", "canonicalTrainingSource"],
              "properties": {
                "allowedForOpenVocabTokenTraining": {
                  "const": true
                },
                "productionRequired": {
                  "const": true
                },
                "lineageId": {
                  "const": "aksharantar-nepali-public-lineage"
                },
                "canonicalTrainingSource": {
                  "const": "ai4bharat-aksharantar-nepali"
                }
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": ["gold", "contract-seed", "licensed-public", "runtime-derived", "dictionary-derived", "teacher-only", "blocked", "local-research-only"]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["available", "optional-local", "not-imported", "teacher-only", "blocked"]
          },
          "rawDataCommitted": {
            "type": "boolean"
          },
          "allowedForOpenVocabTokenTraining": {
            "type": "boolean"
          },
          "productionRequired": {
            "type": "boolean"
          },
          "lineageId": {
            "type": "string",
            "minLength": 1
          },
          "canonicalTrainingSource": {
            "type": "string",
            "minLength": 1
          },
          "defaultPath": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
